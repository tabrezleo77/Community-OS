# PORT: Port the server listens on in production (npm start).
# Most hosting platforms (Render, Railway, Fly.io, Heroku, etc.) set this
# automatically — you usually don't need to set it yourself.
PORT=8787

# API_PORT: Only used by `npm run dev` to tell the Vite dev server which
# port the local API server (npm run dev:server) is running on.
API_PORT=8787
